{
  "name": "eve-jump-planner",
  "productName": "EVE Jump Planner",
  "version": "1.4.0",
  "description": "EVE Online capital jump planner with fuel calculator and New Eden sovereignty map.",
  "main": "main.js",
  "author": "Dale Smith",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-planner.js",
    "dist": "electron-builder --win nsis --publish never",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-desktop-shortcut.ps1"
  },
  "dependencies": {
    "yauzl": "^3.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3",
    "pe-library": "^1.0.1"
  },
  "build": {
    "appId": "com.fivetalents.evejumpplanner",
    "productName": "EVE Jump Planner",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "EVE Jump Planner",
      "artifactName": "EVE-Jump-Planner-Setup-${version}.${ext}"
    },
    "afterPack": "build/after-pack.js",
    "publish": {
      "provider": "github",
      "owner": "fivetalentsrealestate",
      "repo": "New-Eden-Tools",
      "channel": "jump-planner"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fivetalentsrealestate/New-Eden-Tools.git",
    "directory": "apps/eve-jump-planner"
  }
}
