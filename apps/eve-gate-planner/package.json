{
  "name": "eve-gate-planner",
  "productName": "EVE Gate Planner",
  "version": "1.0.0",
  "description": "Local desktop stargate route planner for EVE Online with in-game style autopilot options.",
  "main": "main.js",
  "author": "Dale Smith",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-gates.js",
    "dist": "electron-builder --win nsis",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-desktop-shortcut.ps1"
  },
  "dependencies": {
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3",
    "pe-library": "^1.0.1"
  },
  "build": {
    "appId": "com.fivetalents.evegateplanner",
    "productName": "EVE Gate Planner",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "EVE Gate Planner"
    },
    "afterPack": "build/after-pack.js",
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fivetalentsrealestate/New-Eden-Tools.git",
    "directory": "apps/eve-gate-planner"
  }
}
